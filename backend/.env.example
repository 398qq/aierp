# App
APP_NAME=AIERP
VERSION=2.0.0
DEBUG=true
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=aierp
DB_PASSWORD=
DB_NAME=aierp
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
SLOW_QUERY_THRESHOLD_MS=500

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# AI
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
AI_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
AI_CODE_MODEL=MiniMax-M3
AI_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# CORS
# Comma-separated list is supported.
# Example:
# CORS_ORIGINS=http://localhost:3002,https://erp.example.com
CORS_ORIGINS=http://localhost:3002,http://localhost:5173

# Telegram Notifications (Stage 8 Day 4)
# Used by app.services.telegram_notifier for commission alerts, approvals,
# payment receipts, and any other business event that should ping Telegram.
# Bot handle: @Wechabot_bot (Wechat 助理)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to '1' to silence in dev/test (default unset = enabled)
TELEGRAM_DISABLED=0
# Set to '1' to disable only the legacy inbound getUpdates poller.
TELEGRAM_POLLING_DISABLED=0
